# Which cluster the app reads and signs against: localnet | devnet
VITE_CLUSTER=localnet
VITE_RPC_URL=http://127.0.0.1:8899

# Display names for quote tokens that carry no on-chain metadata (comma-separated mint=SYMBOL).
# On localnet the stand-in USDC is created by scripts/localnet-launch.ts; put its mint here.
VITE_QUOTE_LABELS=
